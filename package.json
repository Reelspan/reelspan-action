{
  "name": "reelspan-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action: publish to 22 social networks with Reelspan.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --legal-comments=none && esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=test/.build/main.js",
    "test": "npm run build && node --test test/action.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "reelspan": "github:Reelspan/reelspan-node#cc5ceabe0aa3dd633b546f6a0a2132c4efded09f",
    "typescript": "^5.9.0"
  }
}
